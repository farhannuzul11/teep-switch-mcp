import os
from dotenv import load_dotenv
from mcp.server.fastmcp import FastMCP
from pyzabbix import ZabbixAPI
from typing import List, Dict, Any

from fastapi import FastAPI
import uvicorn

load_dotenv()

# --- Configuration ---
ZABBIX_URL = os.getenv("ZABBIX_SERVER_URL")
ZABBIX_TOKEN = os.getenv("ZABBIX_API_TOKEN")

# --- Initialize MCP Server ---
mcp = FastMCP("zabbix")

# --- Helper Function ---
def _get_zabbix_connection() -> ZabbixAPI:
    """Establishes and returns a connection to the Zabbix API."""
    if not ZABBIX_URL or not ZABBIX_TOKEN:
        raise ValueError("ZABBIX_SERVER_URL and ZABBIX_API_TOKEN environment variables must be set.")
    
    try:
        zapi = ZabbixAPI(ZABBIX_URL)
        zapi.login(api_token=ZABBIX_TOKEN)
        return zapi
    except Exception as e:
        raise ConnectionError(f"Failed to connect to Zabbix API: {e}") from e

# --- Tool Definitions ---

@mcp.tool()
async def get_hosts(limit: int = 10) -> List[Dict[str, Any]]:
    """
    Retrieves a list of monitored hosts from Zabbix.

    Args:
        limit (int): The maximum number of hosts to return. Defaults to 10.

    Returns:
        List[Dict[str, Any]]: A list of host objects, each containing hostid and name.
    """
    zapi = _get_zabbix_connection()
    hosts = zapi.host.get(output=["hostid", "name", "host"], limit=limit)
    return hosts

@mcp.tool()
async def get_problems(limit: int = 5, min_severity: int = 0) -> List[Dict[str, Any]]:
    """
    Retrieves a list of current, unresolved problems (alerts) from Zabbix.

    Args:
        limit (int): The maximum number of problems to return. Defaults to 5.
        min_severity (int): The minimum problem severity (0-5: Info, Warning, Average, High, Disaster). Defaults to 0.

    Returns:
        List[Dict[str, Any]]: A list of problem objects with detailed information.
    """
    zapi = _get_zabbix_connection()
    problems = zapi.problem.get(output="extend", limit=limit, sortfield=["eventid"], sortorder="DESC", min_severity=min_severity)
    return problems

@mcp.tool()
async def execute_script_on_host(host_name: str, script_name: str) -> Dict[str, Any]:
    """
    Executes a predefined script on a specific host. This is used to 'manage the switch'.

    Args:
        host_name (str): The visible name of the host in Zabbix (e.g., "Cisco-Switch-Floor-1").
        script_name (str): The name of the script to execute (e.g., "Reboot Port").

    Returns:
        Dict[str, Any]: The response from the Zabbix API after executing the script.
    """
    zapi = _get_zabbix_connection()
    hosts = zapi.host.get(filter={"name": host_name}, output=["hostid"])
    if not hosts:
        raise ValueError(f"Host '{host_name}' not found.")
    host_id = hosts[0]['hostid']
    scripts = zapi.script.get(filter={"name": script_name}, output=["scriptid"])
    if not scripts:
        raise ValueError(f"Script '{script_name}' not found.")
    script_id = scripts[0]['scriptid']
    result = zapi.script.execute(scriptid=script_id, hostid=host_id)
    return result

if __name__ == "__main__":
    mcp.run(transport="stdio")


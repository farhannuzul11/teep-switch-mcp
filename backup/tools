@mcp.tool()
async def get_problems(limit: int = 5, min_severity: int = 0) -> List[Dict[str, Any]]:
    """
    Retrieves a list of current, unresolved problems (alerts) from Zabbix.
    Args:
        limit (int): The maximum number of problems to return. Defaults to 5. Max 15.
        min_severity (int): The minimum problem severity (0-5: Info, Warning, Average, High, Disaster). Defaults to 0 (Info).
    Returns:
        List[Dict[str, Any]]: A list of problem objects with detailed information.
    """
    if limit > 15:
        limit = 15
        print(f"Warning: Problem limit reduced to 15 as it exceeds the maximum allowed.")

    zapi = _get_zabbix_connection()
    problems = zapi.problem.get(
        output="extend",
        limit=limit,
        sortfield=["eventid"],
        sortorder="DESC",
        min_severity=min_severity,
        # Hanya ambil masalah yang belum diselesaikan
        # value=0 means Problem (not resolved)
        # value=1 means OK (resolved)
        # Lihat: https://www.zabbix.com/documentation/current/en/manual/api/reference/problem/get
        recent=True # Only retrieve problems with status "Problem"
    )
    return problems

@mcp.tool()
async def get_items_on_host(host_name: str, item_key_filter: Optional[str] = None, limit: int = 10) -> List[Dict[str, Any]]:
    """
    Retrieves a list of items (metrics) configured on a specific host.
    Args:
        host_name (str): The visible name of the host in Zabbix.
        item_key_filter (Optional[str]): Filter items by their key (e.g., "cpu.util", "vfs.fs.size").
        limit (int): The maximum number of items to return. Defaults to 10. Max 50.
    Returns:
        List[Dict[str, Any]]: A list of item objects containing itemid, name, key_, and hostid.
    """
    if limit > 50: # Increased limit for items as there can be many
        limit = 50
        print(f"Warning: Item limit reduced to 50 as it exceeds the maximum allowed.")

    zapi = _get_zabbix_connection()
    hosts = zapi.host.get(filter={"name": host_name}, output=["hostid"])
    if not hosts:
        raise ValueError(f"Host '{host_name}' not found.")
    host_id = hosts[0]['hostid']

    params = {"output": ["itemid", "name", "key_", "hostid"], "hostids": host_id, "limit": limit}
    if item_key_filter:
        params["search"] = {"key_": item_key_filter}
        params["searchByAny"] = True

    items = zapi.item.get(**params)
    return items

@mcp.tool()
async def get_item_history(host_name: str, item_key: str, history_period_seconds: int = 3600) -> List[Dict[str, Any]]:
    """
    Retrieves historical data for a specific item on a host.
    Args:
        host_name (str): The visible name of the host in Zabbix.
        item_key (str): The key of the item (e.g., "cpu.util", "vfs.fs.size[/]").
        history_period_seconds (int): The duration in seconds to retrieve history for (e.g., 3600 for 1 hour). Max 24 hours (86400 seconds).
    Returns:
        List[Dict[str, Any]]: A list of historical data points (each with clock and value).
    """
    if history_period_seconds > 86400: # Max 24 hours
        history_period_seconds = 86400
        print(f"Warning: History period reduced to 24 hours as it exceeds the maximum allowed.")

    zapi = _get_zabbix_connection()
    
    hosts = zapi.host.get(filter={"name": host_name}, output=["hostid"])
    if not hosts:
        raise ValueError(f"Host '{host_name}' not found.")
    host_id = hosts[0]['hostid']

    items = zapi.item.get(filter={"hostid": host_id, "key_": item_key}, output=["itemid", "value_type"])
    if not items:
        raise ValueError(f"Item '{item_key}' not found on host '{host_name}'.")
    item_id = items[0]['itemid']
    value_type = items[0]['value_type'] # This determines history table to query

    time_from = int(time.time()) - history_period_seconds

    # Zabbix history.get requires 'history' parameter based on value_type:
    # 0 - numeric float, 1 - character, 2 - log, 3 - numeric unsigned, 4 - text
    # See: https://www.zabbix.com/documentation/current/en/manual/api/reference/history/get
    # For now, we'll assume numeric types (0, 3) are most common for historical trends.
    # We might need more robust handling for other types if LLM requires it.
    history_type_map = {0: 0, 1: 3, 2: 2, 3: 0, 4: 4} # Mapping item value_type to history type (approximate for common use)
    history_type = history_type_map.get(value_type, 0) # Default to numeric float history if not found

    history_data = zapi.history.get(
        output="extend",
        history=history_type, # Type of history to retrieve (e.g., 0 for float, 3 for int)
        itemids=item_id,
        timefrom=time_from,
        sortfield="clock",
        sortorder="ASC"
    )
    # Convert 'clock' from string to int for consistency if needed, and 'value' to float
    for data_point in history_data:
        data_point['clock'] = int(data_point['clock'])
        try:
            data_point['value'] = float(data_point['value'])
        except ValueError:
            pass # Keep as string if cannot convert to float (e.g., for text/log data)

    return history_data

@mcp.tool()
async def get_triggers_for_host(host_name: str, trigger_name_filter: Optional[str] = None, only_enabled: bool = True) -> List[Dict[str, Any]]:
    """
    Retrieves a list of triggers configured for a specific host.
    Args:
        host_name (str): The visible name of the host in Zabbix.
        trigger_name_filter (Optional[str]): Filter triggers by their description (partial match).
        only_enabled (bool): If True, only return enabled triggers. Defaults to True.
    Returns:
        List[Dict[str, Any]]: A list of trigger objects with triggerid, description, and expression.
    """
    zapi = _get_zabbix_connection()
    hosts = zapi.host.get(filter={"name": host_name}, output=["hostid"])
    if not hosts:
        raise ValueError(f"Host '{host_name}' not found.")
    host_id = hosts[0]['hostid']

    params = {
        "output": ["triggerid", "description", "expression"],
        "hostids": host_id,
        "expandExpression": True, # For full expression detail
        "filter": {"value": 0} if only_enabled else {} # value=0 means Problem state
    }
    if trigger_name_filter:
        params["search"] = {"description": trigger_name_filter}
        params["searchByAny"] = True
    
    triggers = zapi.trigger.get(**params)
    return triggers

@mcp.tool()
async def get_host_groups(group_name_filter: Optional[str] = None) -> List[Dict[str, Any]]:
    """
    Retrieves a list of host groups from Zabbix.
    Args:
        group_name_filter (Optional[str]): Filter host groups by their name (partial match).
    Returns:
        List[Dict[str, Any]]: A list of host group objects with groupid and name.
    """
    zapi = _get_zabbix_connection()
    params = {"output": ["groupid", "name"]}
    if group_name_filter:
        params["search"] = {"name": group_name_filter}
        params["searchByAny"] = True
    
    host_groups = zapi.hostgroup.get(**params)
    return host_groups

@mcp.tool()
async def get_zabbix_api_version() -> str:
    """
    Retrieves the current version of the Zabbix API.
    Returns:
        str: The Zabbix API version string.
    """
    zapi = _get_zabbix_connection()
    version = zapi.apiinfo.version()
    return version
